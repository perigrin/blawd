    <section class="archive-group">
        <h2>} . $group->{label} . q{ (} . $group->{count} . q{)</h2>
        
        <ul class="archive-entries">
            } . (sub {
                my $entries_html = '';
                foreach my $entry (@{$group->{entries} || []}) {
                    $entries_html .= q{
            <li>
                <a href="} . $base_uri . $entry->filename_base() . $extension . q{">} . $entry->title() . q{</a>
                <span class="date">(} . $entry->date()->strftime('%B %d, %Y') . q{)</span>
            </li>};
                }
                return $entries_html;
            }->()) . q{
        </ul>
    </section>};
        }
        return $groups_html;
    }->()) . q{
